+// Blocking-event logging globals. g_block_log is only set (non-null) inside
+// run_enum_cartwheels; run_enum_wheels never touches it, so --enum_wheels runs incur no logging
+// and no output file.
+std::ofstream *g_block_log = nullptr;
+string g_block_log_wheel_id;
+
+void log_blocking_event(const CartWheel &cw, const vector<string> &matched_names) {
+    if (g_block_log == nullptr) {
+        return;
+    }
+    size_t state_hash = std::hash<string>{}(cw.to_string());
+    *g_block_log << g_block_log_wheel_id << "\t" << state_hash << "\t"
+                 << fmt::format("{}", fmt::join(matched_names, ",")) << "\n";
+    g_block_log->flush();
+}
 
