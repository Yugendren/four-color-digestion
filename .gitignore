data/
.venv/
build/
__pycache__/
*.pyc
.DS_Store
checkpoints/
third_party/*/extracted_build/
# P3 pipeline re-runs (tools/p3_pipeline_run.sh): work/ and log/ hold the regenerated
# combined_rules/wheels/cartwheels + thousands of per-wheel logs for one candidate pool
# -- large (GB-scale) and fully reproducible from the pool manifest, so only the run's
# top-level bookkeeping (driver.log, DONE_* markers, pool_manifest.sha256, counts.json,
# checksums.sha256, VERDICT.txt) is tracked.
results/p3/runs/*/work/
results/p3/runs/*/log/

# Steinberger S1 gap analysis (tools/s1_gap_analysis.py): the at-risk glued-composite
# list is derived from the 14.6M-event full-pool gluing blocklog and is ~13MB, fully
# regenerated in ~15s from tracked inputs -- same rationale as the p3 work/log
# exclusion above. gap_analysis.json and the two small JSONL lists stay tracked.
results/steinberger-s1/at_risk_composites.jsonl
results/steinberger-s1/gluelog/

# D1 interrogation (tools/d1_interrogate.py): the full-corpus pooled-
# encoder-state artifact is a ~16MB binary blob, fully reproducible from
# the checkpoint + corpus in well under a minute -- same rationale as the
# p3 work/log exclusion above. report.md and the JSON summaries (small,
# and what the write-up actually cites) stay tracked.
results/d1/interp/*.npz

# D1-v2 datagen (tools/d1v2_datagen.py plantri): PID files from detached
# background generation jobs are host/run-transient bookkeeping, not
# results. The live progress logs (log_plantri_r{r}_n18.txt) are kept
# untracked while a job is in flight; commit a final snapshot once
# generation completes.
results/d1v2/*.pid
results/d1v2/log_plantri_*.txt

# Theorem-candidate adversarial stress test (tools/stress_test_theorem.py):
# the live progress log + continuously-rewritten checkpoint + nohup wrapper
# output are host/run-transient bookkeeping for a background run in flight,
# same rationale as the d1v2 plantri logs above. stress_test.json/.md (the
# tool's own final-snapshot outputs, periodically re-captured from the
# checkpoint while a run is in progress) stay tracked.
results/theorem/stress_test.log
results/theorem/stress_test_checkpoint.json
results/theorem/stress_test_nohup.out
